# Copy to .env and fill in. Never commit .env.
VAULT=vault.kaelvor.testnet
AGENT=agent.kaelvor.testnet
GUARDIAN=guardian.kaelvor.testnet
OWNER=kaelvor.testnet
RPC_URLS=https://test.rpc.fastnear.com,https://archival-rpc.testnet.fastnear.com,https://rpc.testnet.near.org

# NEAR AI Cloud. Leave the key empty to run with built-in rules only.
NEAR_AI_API_KEY=
# Canonical ID of a NEAR-hosted, attested model (see /v1/model/list, "verifiable": true).
NEAR_AI_MODEL=z-ai/glm-5.3-flash
# Set to 1 to let the agent read invoices with AI instead of the naive parser.
AGENT_AI=0
